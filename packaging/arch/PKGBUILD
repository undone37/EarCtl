# Builds from the repo checkout (two levels up), not from a tarball.
# ponytail: AUR would need source=(…tar.gz) + sha256sums, add when publishing there
pkgname=earctl
pkgver=0
pkgrel=1
pkgdesc="Sony WH-1000XM3/XM4 Einstellungen unter Linux (Tray + CLI)"
arch=('x86_64')
license=('MIT')
depends=('dbus' 'bluez' 'gcc-libs' 'glibc' 'libxkbcommon' 'libglvnd' 'wayland' 'libx11' 'libxcursor' 'libxrandr' 'libxi')
makedepends=('cargo')
options=('!lto' '!debug')

_root() { realpath "$startdir/../.."; }

pkgver() {
  grep -m1 '^version' "$(_root)/Cargo.toml" | cut -d'"' -f2
}

build() {
  cd "$(_root)"
  cargo build --release --locked
}

package() {
  cd "$(_root)"
  install -Dm755 target/release/earctl "$pkgdir/usr/bin/earctl"
  install -Dm644 earctl.desktop "$pkgdir/usr/share/applications/earctl.desktop"
  install -Dm644 earctl.desktop "$pkgdir/etc/xdg/autostart/earctl.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
